{
  "name": "mermaid-viewer-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "build:dev": "pnpm -r --filter \"./packages/*\" run build:dev",
    "dev": "pnpm -r --parallel --filter \"./packages/*\" run dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:types": "pnpm -r --filter \"./packages/*\" run check:types",
    "check:lint": "eslint",
    "check:format": "pnpm run format:check",
    "check:ssr": "node scripts/check-package-imports.mjs",
    "check:examples": "pnpm -r --filter \"./examples/*\" run check:types && pnpm -r --filter \"./examples/*\" run check:ssr && pnpm -r --filter \"./examples/*\" run build",
    "check:all": "pnpm run check:format && pnpm run build && pnpm run check:lint && pnpm run check:types && pnpm run test:run",
    "test": "pnpm -r --parallel --filter \"./packages/*\" run test",
    "test:run": "pnpm -r --filter \"./packages/*\" run test:run",
    "test:coverage": "pnpm -r --filter \"./packages/*\" run test:coverage",
    "release:check": "pnpm run check:all && pnpm run check:ssr && pnpm --dir packages/viewer pack --dry-run && pnpm --dir packages/vue pack --dry-run && pnpm --dir packages/vitepress pack --dry-run",
    "release:publish": "pnpm run release:check && pnpm --dir packages/vitepress exec npm publish",
    "release:publish:beta": "pnpm run release:check && pnpm --dir packages/vitepress exec npm publish --tag beta",
    "docs:dev": "pnpm --filter mermaid-viewer-docs run dev",
    "docs:build": "pnpm --filter mermaid-viewer-docs run build",
    "docs:preview": "pnpm --filter mermaid-viewer-docs run preview",
    "docs:indexnow": "node scripts/indexnow.mjs",
    "example:vue": "pnpm --filter vue-mermaid-viewer-example run dev",
    "example:vanilla": "pnpm --filter mermaid-viewer-vanilla-example run dev",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,vue}": "eslint --fix",
    "*.{ts,js,json,md,vue,css}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-kassaila": "^0.2.0",
    "eslint-plugin-vue": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  }
}
