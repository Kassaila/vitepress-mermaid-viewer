{
  "name": "vue-mermaid-viewer",
  "version": "0.1.0",
  "description": "Interactive Mermaid diagrams for Vue",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mermaid": {
      "types": "./dist/mermaid.d.ts",
      "import": "./dist/mermaid.js",
      "default": "./dist/mermaid.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "author": "Kassaila",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kassaila/vitepress-mermaid-viewer.git",
    "directory": "packages/vue"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "mermaid": "^11.16.1 || ^12",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "mermaid-viewer": "workspace:^"
  },
  "scripts": {
    "build": "tsdown",
    "build:dev": "NODE_ENV=development tsdown",
    "dev": "tsdown --watch",
    "check:types": "vue-tsc --noEmit --declaration false --declarationMap false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@tsdown/css": "^0.21.6",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "^4.1.2",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.8.9",
    "mermaid": "11.17.2",
    "tsdown": "^0.21.6",
    "typescript": "^5.9.3",
    "unplugin-vue": "^7.1.1",
    "vitest": "^4.1.2",
    "vue": "3.5.40",
    "vue-tsc": "^3.2.6"
  }
}
