{
  "name": "vitepress-mermaid-viewer",
  "version": "0.5.1",
  "description": "Mermaid diagrams for VitePress with interactive zoom, pan, and fullscreen viewing",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./Mermaid": {
      "import": "./dist/Mermaid.js",
      "require": "./dist/Mermaid.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "keywords": [
    "vitepress",
    "mermaid",
    "zoom",
    "pan",
    "fullscreen",
    "diagram",
    "vitepress-plugin",
    "markdown"
  ],
  "author": "Kassaila",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kassaila/vitepress-mermaid-viewer.git",
    "directory": "packages/vitepress"
  },
  "bugs": {
    "url": "https://github.com/Kassaila/vitepress-mermaid-viewer/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "homepage": "https://kassaila.github.io/vitepress-mermaid-viewer/",
  "peerDependencies": {
    "mermaid": ">=10",
    "vitepress": ">=1.0.0",
    "vue": "^3.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "build:dev": "NODE_ENV=development tsdown",
    "dev": "tsdown --watch",
    "check:types": "tsc --noEmit --declaration false --declarationMap false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run check:types"
  },
  "devDependencies": {
    "@tsdown/css": "^0.21.6",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "^4.1.2",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.8.9",
    "mermaid": "11.16.0",
    "tsdown": "^0.21.6",
    "typescript": "^5.9.3",
    "unplugin-vue": "^7.1.1",
    "vitepress": "2.0.0-alpha.17",
    "vitest": "^4.1.2",
    "vue": "3.5.40",
    "vue-tsc": "^3.2.6"
  }
}
